{
  "name": "react-upi-qr",
  "version": "0.1.0",
  "description": "Take a UPI payment on the web with React: a QR code to scan on desktop, Pay with UPI links on phones, and polling of your server until it confirms the payment. Typed URL building and validation, SSR-safe, React 17 to 19.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./styles.css": "./lib/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "author": "Moksh Upadhyay <mokshupadhyay4@gmail.com> (https://mokshupadhyay.com)",
  "homepage": "https://github.com/mokshupadhyay/react-upi-qr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokshupadhyay/react-upi-qr.git"
  },
  "bugs": {
    "url": "https://github.com/mokshupadhyay/react-upi-qr/issues"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:compat": "npm run build && node scripts/react-compat.cjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react",
    "upi",
    "upi-payment",
    "upi-qr",
    "qr-code",
    "india",
    "payments",
    "checkout",
    "npci",
    "bhim",
    "nextjs",
    "ssr"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^29.7.0",
    "fast-check": "^4.11.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
